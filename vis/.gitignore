# Unity .gitignore for the vis/ folder (OvercookAR visualizer).

# Folders Unity rebuilds itself. Never commit these.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Build output (the Xcode project Unity generates, and any other builds)
/[Bb]uild/
/[Bb]uilds/
/[Bb]uild*/
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/

# Xcode archives and installers
*.ipa
*.xcarchive
*.app
*.apk
*.aab
*.dSYM
*.dSYM.zip

# Unity-generated IDE project files
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and profiler captures
sysinfo.txt
crashlytics-build.properties
*.unitypackage
*.app.meta

# Addressables / Gradle leftovers
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
.gradle/

# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Note: .meta files are NOT ignored on purpose. Unity needs them to keep
# references between assets, so always commit them alongside their files.
